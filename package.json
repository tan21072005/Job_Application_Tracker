{
  "name": "jobtrack-workspace",
  "private": true,
  "workspaces": [
    "apps/experiences",
    "packages/jobtrack-core",
    "packages/jobtrack-contract",
    "packages/jobtrack-mcp"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev -- --port 64364 --strictPort",
    "build:web": "npm --prefix apps/web run build",
    "test:web": "npm --prefix apps/web run test",
    "dev:api": "npm --prefix apps/api run dev",
    "build:api": "npm --prefix apps/api run build",
    "test:api": "npm --prefix apps/api run test",
    "build:mcp": "npm --prefix packages/jobtrack-mcp run build",
    "test:mcp": "npm --prefix packages/jobtrack-mcp run test",
    "check:mcp": "npm run build:mcp && npm run test:mcp",
    "test:ai": "npm run test:mcp && npm run test:api",
    "db:migrate": "npm --prefix apps/api run migrate",
    "dev:experiences": "npm run dev --workspace jobtrack-five-experiences",
    "build:experiences": "npm run build --workspace jobtrack-five-experiences",
    "test:experiences": "npm run test --workspace jobtrack-five-experiences",
    "check:architecture": "python docs/system-design/validate_design.py",
    "agent:loop": "node tools/agent-control/cli.mjs run",
    "agents": "node tools/agent-control/cli.mjs",
    "agents:run": "node tools/agent-control/cli.mjs run",
    "agents:test": "node --test --test-concurrency=1 tools/agent-control/*.test.mjs",
    "test:agent-loop": "node --test tools/agent-loop/*.test.mjs",
    "setup:docker": "node tools/docker/setup.mjs",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:status": "docker-compose ps",
    "docker:logs": "docker-compose logs",
    "check:stack": "npm run build:api && npm run test:api",
    "test:contract": "npm --prefix packages/jobtrack-contract run test",
    "check:contract": "npm --prefix packages/jobtrack-contract run build && npm --prefix packages/jobtrack-contract run test",
    "test:extension": "node --test packages/jobtrack-extension/extension.test.mjs",
    "check:all": "npm run check:contract && npm run check:stack && npm run check:mcp && npm run test:extension && npm run test:web && npm run build:web && npm run test:agent-loop && npm run check:architecture",
    "db:backup": "node tools/ops/backup.mjs create",
    "db:backup:status": "node tools/ops/backup.mjs status",
    "db:backup:schedule": "node tools/ops/backup.mjs schedule",
    "db:restore": "node tools/ops/restore.mjs",
    "db:load-test": "node tools/ops/load-test.mjs",
    "db:rollback-drill": "node tools/ops/rollback-drill.mjs",
    "evidence:capture": "node tools/capture-evidence.mjs",
    "account:create": "node tools/create-account.mjs"
  }
}
