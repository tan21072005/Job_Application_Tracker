        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="http">
          <mxGeometry x="45" y="90" width="10" height="400" as="geometry" />
        </mxCell>
        <mxCell id="m0" value="POST /applications + same Idempotency-Key" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1552;entryX=0;entryY=0.0;" edge="1" parent="1" source="client" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Validated session / Origin / DTO" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.125;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="BEGIN; session FOR SHARE; owner FOR UPDATE" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="Lookup scoped key/hash; replay before writing" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.25;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Check active OR identity; terminal needs confirmation" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="INSERT application + saved 201 response; COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6667;entryX=0;entryY=0.75;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="COMMIT acknowledged" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#526571;fontColor=#526571;exitX=0;exitY=1.0;entryX=1;entryY=0.8333;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="Committed result" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#526571;fontColor=#526571;exitX=0;exitY=1.0;entryX=1;entryY=0.875;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="201 application; retry returns original response" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#526571;fontColor=#526571;exitX=0;exitY=1.0;entryX=0.5;entryY=0.8448;" edge="1" parent="1" source="act2" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
