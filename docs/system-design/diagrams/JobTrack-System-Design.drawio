          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="BEGIN; session lock then owner lock" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
