{
  "name": "jobtrack-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "test": "node --test --env-file-if-exists=.env.test src/*.test.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "express": "^5.2.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
