  "components": [
    {
      "name": "Dossier primary action",
      "kind": "button",
      "refersTo": "dossier-button-primary",
      "description": "Deep red explicit save action.",
      "html": "<button class=\"ds-dossier-primary\">Lưu thay đổi</button>",
      "css": ".ds-dossier-primary{font:17px/1.5 'Source Sans 3',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 16px;color:#fff;background:#963e37;border:1px solid #963e37;border-radius:3px;cursor:pointer}.ds-dossier-primary:hover{background:#7f312c}.ds-dossier-primary:focus-visible{outline:2px solid #963e37;outline-offset:4px}.ds-dossier-primary:disabled{opacity:.5;cursor:wait}"
    },
    {
      "name": "Dossier text field",
      "kind": "input",
      "refersTo": "dossier-input",
      "description": "Labeled full-width field from the dossier editor.",
      "html": "<label class=\"ds-dossier-field\" for=\"ds-d-company\">Tên công ty *</label><input class=\"ds-dossier-input\" id=\"ds-d-company\" value=\"FPT Software\" />",
      "css": ".ds-dossier-field{display:block;font:600 14px/1.5 'Source Sans 3',sans-serif;color:#263b3d;margin-bottom:7px}.ds-dossier-input{width:100%;min-height:44px;border:1px solid #899b98;border-radius:3px;background:#fff;color:#263b3d;padding:10px 12px;font:17px/1.5 'Source Sans 3',sans-serif;caret-color:#963e37}.ds-dossier-input:focus-visible{outline:2px solid #963e37;outline-offset:4px}"
    },
    {
      "name": "Rhythm top navigation",
      "kind": "nav",
      "refersTo": "rhythm-header-nav",
      "description": "Current destination uses blue ink and a bottom rule.",
      "html": "<nav class=\"ds-rhythm-nav\" aria-label=\"Điều hướng\"><button aria-current=\"page\">Lịch</button><button>Hồ sơ</button><button>Tổng quan</button></nav>",
      "css": ".ds-rhythm-nav{display:flex;gap:29px;min-height:49px;border-bottom:1px solid #c5cec9}.ds-rhythm-nav button{position:relative;border:0;border-radius:0;padding:0;background:none;font:400 14px/1.4 'Noto Sans',sans-serif;color:#203c50;min-height:44px;cursor:pointer}.ds-rhythm-nav button[aria-current=page]{font-weight:600;color:#225c79}.ds-rhythm-nav button[aria-current=page]:after{position:absolute;bottom:-1px;left:0;right:0;height:3px;background:#225c79;content:''}.ds-rhythm-nav button:hover{background:#e4e8e2}.ds-rhythm-nav button:focus-visible{outline:3px solid #a64d1f;outline-offset:4px}"
    },
    {
      "name": "Rhythm status chip",
      "kind": "chip",
      "refersTo": "rhythm-status-chip",
      "description": "Interview status remains explicit text on a quiet categorical surface.",
      "html": "<span class=\"ds-rhythm-chip\">Phỏng vấn</span>",
      "css": ".ds-rhythm-chip{display:inline-block;font:600 11px/1.6 'Noto Sans',sans-serif;padding:3px 9px;background:#e0eaf0;border:1px solid #b2c9d6;border-radius:4px;color:#22516b}"
    },
    {
      "name": "Rhythm selected date",
      "kind": "button",
      "refersTo": "rhythm-date-selected",
      "description": "A selected date in the seven-day navigation strip.",
      "html": "<button class=\"ds-rhythm-date\" aria-pressed=\"true\"><span>Thứ tư</span><strong>14</strong><i aria-hidden=\"true\"></i></button>",
      "css": ".ds-rhythm-date{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;min-height:79px;min-width:65px;padding:10px 17px;border:0;border-radius:5px;background:#225c79;color:#fff;font:400 14px/1.4 'Noto Sans',sans-serif;cursor:pointer}.ds-rhythm-date span{font-size:12px}.ds-rhythm-date strong{font:600 28px/1.4 Archivo,sans-serif;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-rhythm-date i{display:block;height:4px;width:4px;border-radius:50%;background:currentColor;margin-top:2px}.ds-rhythm-date:hover{background:#225c79;color:#fff}.ds-rhythm-date:focus-visible{outline:3px solid #a64d1f;outline-offset:4px}"
    },
    {
      "name": "Atlas primary action",
      "kind": "button",
      "refersTo": "atlas-button-primary",
      "description": "Cobalt action from the status workspace.",
      "html": "<button class=\"ds-atlas-primary\">Thêm hồ sơ</button>",
      "css": ".ds-atlas-primary{font:14px/1.3 'Public Sans',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;cursor:pointer;border:1px solid #214eca;background:#214eca;color:#fff;border-radius:4px}.ds-atlas-primary:hover{background:#163ba0;border-color:#163ba0}.ds-atlas-primary:focus-visible{outline:3px solid #214eca;outline-offset:3px}.ds-atlas-primary:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Atlas selected region",
      "kind": "card",
      "refersTo": "atlas-region-selected",
      "description": "Named region with count and readable application row.",
      "html": "<section class=\"ds-atlas-region\"><button class=\"ds-atlas-region-heading\"><span>Đã nộp</span><span>2</span></button><button class=\"ds-atlas-row\"><span><strong>React Developer</strong><small>VNG</small></span><span>Liên hệ recruiter</span></button></section>",
      "css": ".ds-atlas-region{background:#fafaf6;border:2px solid #214eca;border-radius:3px;padding:18px 20px;color:#262333;max-width:600px}.ds-atlas-region-heading{display:flex;align-items:start;justify-content:space-between;width:100%;border:0;padding:0;min-height:36px;background:transparent;color:#214eca;cursor:pointer;font:600 31px/1.05 'Barlow Condensed',sans-serif;letter-spacing:-.02em}.ds-atlas-region-heading span:last-child{font-size:34px;font-variant-numeric:tabular-nums}.ds-atlas-row{display:grid;grid-template-columns:1.2fr 1fr;gap:13px;align-items:center;text-align:left;width:100%;min-height:80px;border:0;border-top:1px solid #d0cccf;border-radius:0;background:transparent;padding:13px 9px;margin-top:15px;color:#262333;font:12px/1.55 'Public Sans',sans-serif;cursor:pointer}.ds-atlas-row strong{display:block;font-size:14px;font-weight:600}.ds-atlas-row small{display:block;color:#595461;font-size:12px;margin-top:3px}.ds-atlas-row:hover{background:#e8e8e1}.ds-atlas-region button:focus-visible{outline:3px solid #214eca;outline-offset:3px}"
    },
    {
      "name": "Workbench primary action",
      "kind": "button",
      "refersTo": "workbench-button-primary",
      "description": "Compact teal save control in the editor dock.",
      "html": "<button class=\"ds-workbench-primary\">Lưu thay đổi</button>",
      "css": ".ds-workbench-primary{background:#17616b;color:#fff;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid #17616b;border-radius:3px;font:600 12px/1.6 'Noto Sans',sans-serif;cursor:pointer}.ds-workbench-primary:hover:not(:disabled){filter:brightness(.95)}.ds-workbench-primary:focus-visible{outline:3px solid #b07b15;outline-offset:3px}.ds-workbench-primary:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Workbench bottom editor dock",
      "kind": "custom",
      "refersTo": "workbench-editor-dock",
      "description": "Editor surface below the table; tabs identify content without a card scaffold.",
      "html": "<section class=\"ds-workbench-deck\"><header><div><h1>Frontend Developer</h1><p>FPT Software</p></div><nav aria-label=\"Nội dung hồ sơ\"><button aria-pressed=\"true\">Thông tin</button><button aria-pressed=\"false\">Phỏng vấn</button></nav></header><p class=\"ds-workbench-deck-note\">Ghi chú và một bước tiếp theo</p></section>",
      "css": ".ds-workbench-deck{background:#fff;color:#243943;border:1px solid #c7d4d8;padding:26px 28px;font:14px/1.6 'Noto Sans',sans-serif;max-width:900px}.ds-workbench-deck header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:20px;border-bottom:1px solid #c7d4d8;margin-bottom:24px}.ds-workbench-deck h1{font:700 28px/1.3 'IBM Plex Sans Condensed',sans-serif;margin:4px 0 0}.ds-workbench-deck p{font-size:12px;color:#566d76;margin:5px 0 0}.ds-workbench-deck nav{display:flex;gap:12px}.ds-workbench-deck button{background:transparent;color:#566d76;padding:9px 12px;font:12px/1.6 'Noto Sans',sans-serif;min-height:44px;border:0;border-bottom:2px solid transparent;cursor:pointer}.ds-workbench-deck button[aria-pressed=true]{color:#17616b;border-bottom-color:#17616b}.ds-workbench-deck button:hover{text-decoration:underline}.ds-workbench-deck button:focus-visible{outline:3px solid #b07b15;outline-offset:3px}.ds-workbench-deck .ds-workbench-deck-note{font-size:14px;font-weight:600;color:#243943}@media(max-width:700px){.ds-workbench-deck header{display:block}.ds-workbench-deck nav{margin-top:18px;flex-wrap:wrap}}"
    },
    {
      "name": "Index expanded status band",
      "kind": "custom",
      "refersTo": "indexer-status-band-open",
      "description": "Full-width expanded status heading and a continuous application row.",
      "html": "<section class=\"ds-index-band\"><button class=\"ds-index-toggle\" aria-expanded=\"true\" aria-controls=\"ds-index-panel\"><span>Đã nộp</span><span>2 −</span></button><div id=\"ds-index-panel\"><button class=\"ds-index-row\"><span>React Developer <small>VNG</small></span><span>Liên hệ recruiter ↗</span></button></div></section>",
      "css": ".ds-index-band{background:var(--mustard,#d9bc49);color:var(--ink,#292923);padding:0 25px}.ds-index-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;gap:20px;min-height:111px;background:transparent;border:0;padding:0;color:inherit;cursor:pointer}.ds-index-toggle span:first-child{font:600 clamp(42px,4.4vw,64px)/1.1 'Bricolage Grotesque','Noto Sans',sans-serif;letter-spacing:-.03em}.ds-index-toggle span:last-child{font:23px 'Noto Sans',sans-serif;font-variant-numeric:tabular-nums}.ds-index-toggle:hover span:first-child{color:#77703d}.ds-index-row{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;width:100%;gap:24px;text-align:left;border:0;border-top:1px solid #a08b3a;background:transparent;color:inherit;padding:20px 0;min-height:78px;cursor:pointer;font:13px 'Noto Sans',sans-serif}.ds-index-row>span:first-child{font:600 21px 'Bricolage Grotesque','Noto Sans',sans-serif;letter-spacing:-.015em}.ds-index-row small{font:400 13px 'Noto Sans',sans-serif;margin-left:16px;color:#4c461f}.ds-index-row:hover>span:first-child{text-decoration:underline;text-underline-offset:5px}.ds-index-band button:focus-visible{outline:3px solid #8b6f08;outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "Five Working Worlds",
    "overview": "The five approved concepts share JobTrack's application domain while preserving independent composition, typography and navigation. Their names describe visual worlds: an open dossier, a working agenda, a status landscape, a precision tabletop and a living index. This document indexes actual source tokens; each world's DESIGN.md governs its local screens.\n\nThe default experience uses labeled, synthetic demo records. Live authentication, ownership and persistence require the documented API backend; backend acceptance remains pending. This visual inventory makes no production-readiness claim.",
    "keyCharacteristics": [
      "Independent React compositions and scoped world styling.",
      "Readable Vietnamese text, named states and explicit save actions.",
      "Responsive transformations preserve each world's organizing idea."
    ],
    "rules": [
      {
        "name": "The World Boundary Rule",
        "body": "Apply one world's tokens within its own experience; preserve its local composition when adding a screen.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve each world's approved navigation and mobile transformation.",
      "Do keep status labels and explicit save, error and confirmation feedback readable.",
      "Do identify demo data and verify real account behavior against the backend separately."
    ],
    "donts": [
      "Don't collapse the worlds into color variants of one dashboard shell.",
      "Don't add visual claims of status history, geography, calendar sync or AI features.",
      "Don't treat source inspection as backend acceptance."
    ]
  }
}
